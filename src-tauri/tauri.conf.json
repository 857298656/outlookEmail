{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OutlookEmail Desktop",
  "version": "0.2.0",
  "identifier": "com.outlookemail.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OutlookEmail Desktop",
        "width": 600,
        "height": 600,
        "minWidth": 600,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGODhFODBDOTFGOTA2NTAKUldSUUJ2bVJET2lJcjdwdis5SVZub2E1UEhmU2phRWVJTktBUGtkTXlDRjNEOXhHSHdTSjRwWTcK",
      "endpoints": [
        "https://github.com/857298656/outlookEmail/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
